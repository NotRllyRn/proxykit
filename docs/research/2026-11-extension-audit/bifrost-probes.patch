+// ProxyKit audit probes: temporary checkout only, synthetic local callbacks.
+type auditMixedManager struct{ MockAutoClientManager }
+
+func (m *auditMixedManager) GetClientForTool(ctx context.Context, name string) (*schemas.MCPClientState, *schemas.MCPDiscovery) {
+	if name == "client_tool" {
+		return nil, nil
+	}
+	return m.MockAutoClientManager.GetClientForTool(ctx, name)
+}
+func auditCall(id, name string) schemas.ChatAssistantMessageToolCall {
+	return schemas.ChatAssistantMessageToolCall{ID: schemas.Ptr(id), Function: schemas.ChatAssistantMessageToolCallFunction{Name: schemas.Ptr(name), Arguments: "{}"}}
+}
+func auditResponse(calls ...schemas.ChatAssistantMessageToolCall) *schemas.BifrostChatResponse {
+	return &schemas.BifrostChatResponse{Choices: []schemas.BifrostResponseChoice{{FinishReason: schemas.Ptr("tool_calls"), ChatNonStreamResponseChoice: &schemas.ChatNonStreamResponseChoice{Message: &schemas.ChatMessage{Role: schemas.ChatMessageRoleAssistant, ChatAssistantMessage: &schemas.ChatAssistantMessage{ToolCalls: calls}}}}}}
+}
+func TestProxyKitAuditMixedHandoff(t *testing.T) {
+	ctx := schemas.NewBifrostContext(context.Background(), schemas.NoDeadline)
+	executed, continued := 0, 0
+	result, err := (&AgentModeExecutor{logger: &MockLogger{}}).ExecuteAgentForChatRequest(ctx, 3, &schemas.BifrostChatRequest{}, auditResponse(auditCall("gateway-id", "gateway_tool"), auditCall("client-id", "client_tool")), func(*schemas.BifrostContext, *schemas.BifrostChatRequest) (*schemas.BifrostChatResponse, *schemas.BifrostError) {
+		continued++
+		return auditResponse(), nil
+	}, nil, func(_ *schemas.BifrostContext, r *schemas.BifrostMCPRequest) (*schemas.BifrostMCPResponse, error) {
+		executed++
+		return &schemas.BifrostMCPResponse{ChatMessage: createToolResultMessage(*r.ChatAssistantMessageToolCall, "gateway-result", nil)}, nil
+	}, &auditMixedManager{})
+	if err != nil || executed != 1 || continued != 0 {
+		t.Fatalf("err=%v executed=%d continued=%d", err, executed, continued)
+	}
+	calls := extractToolCalls(result)
+	if len(calls) != 1 || *calls[0].ID != "client-id" {
+		t.Fatalf("pending calls: %+v", calls)
+	}
+	if !strings.Contains(*result.Choices[0].Message.Content.ContentStr, "gateway-result") {
+		t.Fatal("missing summary")
+	}
+	t.Logf("gateway executions=%d continuation calls=%d pending ID=%s finish_reason=%s", executed, continued, *calls[0].ID, *result.Choices[0].FinishReason)
+}
+func TestProxyKitAuditRepeatedToolSummaryLoss(t *testing.T) {
+	calls := []schemas.ChatAssistantMessageToolCall{auditCall("first-id", "lookup"), auditCall("second-id", "lookup")}
+	results := []*schemas.ChatMessage{createToolResultMessage(calls[0], "first-unique-result", nil), createToolResultMessage(calls[1], "second-unique-result", nil)}
+	result := createChatResponseWithExecutedToolsAndNonAutoExecutableCalls(auditResponse(), results, calls, []schemas.ChatAssistantMessageToolCall{auditCall("client-id", "client_tool")})
+	body := *result.Choices[0].Message.Content.ContentStr
+	// Pin observed defect rather than presenting a failing desired-behavior test as a harness error.
+	if strings.Contains(body, "first-unique-result") || !strings.Contains(body, "second-unique-result") {
+		t.Fatalf("observed behavior changed: %s", body)
+	}
+	t.Logf("OBSERVED LOSS: same-name result overwritten: %s", body)
+}
+func TestProxyKitAuditCanceledContextStillDispatches(t *testing.T) {
+	parent, cancel := context.WithCancel(context.Background())
+	cancel()
+	ctx := schemas.NewBifrostContext(parent, schemas.NoDeadline)
+	toolCalls, llmCalls := 0, 0
+	_, err := (&AgentModeExecutor{logger: &MockLogger{}}).ExecuteAgentForChatRequest(ctx, 1, &schemas.BifrostChatRequest{}, auditResponse(auditCall("gateway-id", "gateway_tool")), func(c *schemas.BifrostContext, _ *schemas.BifrostChatRequest) (*schemas.BifrostChatResponse, *schemas.BifrostError) {
+		llmCalls++
+		if c.Err() == nil {
+			t.Error("lost cancellation")
+		}
+		return auditResponse(), nil
+	}, nil, func(c *schemas.BifrostContext, r *schemas.BifrostMCPRequest) (*schemas.BifrostMCPResponse, error) {
+		toolCalls++
+		return &schemas.BifrostMCPResponse{ChatMessage: createToolResultMessage(*r.ChatAssistantMessageToolCall, "result", nil)}, nil
+	}, &MockAutoClientManager{})
+	if err != nil || toolCalls != 1 || llmCalls != 1 {
+		t.Fatalf("err=%v tool=%d llm=%d", err, toolCalls, llmCalls)
+	}
+	t.Log("Already-canceled context still dispatches tool and continuation callbacks; cancellation enforcement depends on callees")
+}
+func TestProxyKitAuditToolFanout(t *testing.T) {
+	const n = 64
+	started := make(chan struct{}, n)
+	release := make(chan struct{})
+	done := make(chan struct{})
+	calls := make([]schemas.ChatAssistantMessageToolCall, n)
+	for i := range calls {
+		calls[i] = auditCall(fmt.Sprint(i), "gateway_tool")
+	}
+	go func() {
+		defer close(done)
+		(&AgentModeExecutor{logger: &MockLogger{}}).ExecuteAgentForChatRequest(schemas.NewBifrostContext(context.Background(), schemas.NoDeadline), 1, &schemas.BifrostChatRequest{}, auditResponse(calls...), func(*schemas.BifrostContext, *schemas.BifrostChatRequest) (*schemas.BifrostChatResponse, *schemas.BifrostError) {
+			return auditResponse(), nil
+		}, nil, func(_ *schemas.BifrostContext, r *schemas.BifrostMCPRequest) (*schemas.BifrostMCPResponse, error) {
+			started <- struct{}{}
+			<-release
+			return &schemas.BifrostMCPResponse{ChatMessage: createToolResultMessage(*r.ChatAssistantMessageToolCall, "result", nil)}, nil
+		}, &MockAutoClientManager{})
+	}()
+	count := 0
+	timer := time.NewTimer(3 * time.Second)
+	defer timer.Stop()
+	for count < n {
+		select {
+		case <-started:
+			count++
+		case <-timer.C:
+			close(release)
+			<-done
+			t.Fatalf("only %d concurrently entered", count)
+		}
+	}
+	close(release)
+	<-done
+	t.Logf("all %d tools entered concurrently before any completed; no agent-loop fanout cap", count)
+}
