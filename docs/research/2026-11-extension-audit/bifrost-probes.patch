+func TestProxyKitAuditAgentUsageIncludesContinuation(t *testing.T) {
+	initial := auditResponse(auditCall("gateway-id", "gateway_tool"))
+	initial.Usage = &schemas.BifrostLLMUsage{PromptTokens: 10, CompletionTokens: 2, TotalTokens: 12}
+	next := auditResponse()
+	next.Usage = &schemas.BifrostLLMUsage{PromptTokens: 20, CompletionTokens: 3, TotalTokens: 23}
+	result, err := (&AgentModeExecutor{logger: &MockLogger{}}).ExecuteAgentForChatRequest(schemas.NewBifrostContext(context.Background(), schemas.NoDeadline), 2, &schemas.BifrostChatRequest{}, initial, func(_ *schemas.BifrostContext, r *schemas.BifrostChatRequest) (*schemas.BifrostChatResponse, *schemas.BifrostError) {
+		if len(r.Input) != 2 || r.Input[1].ChatToolMessage == nil || *r.Input[1].ChatToolMessage.ToolCallID != "gateway-id" {
+			t.Errorf("continuation lost tool pairing: %+v", r.Input)
+		}
+		return next, nil
+	}, nil, func(_ *schemas.BifrostContext, r *schemas.BifrostMCPRequest) (*schemas.BifrostMCPResponse, error) {
+		return &schemas.BifrostMCPResponse{ChatMessage: createToolResultMessage(*r.ChatAssistantMessageToolCall, "result", nil)}, nil
+	}, &MockAutoClientManager{})
+	if err != nil || result.Usage.TotalTokens != 35 || result.Usage.PromptTokens != 30 || result.Usage.CompletionTokens != 5 {
+		t.Fatalf("err=%v usage=%+v", err, result.Usage)
+	}
+	t.Logf("initial total=12 continuation total=23 delivered total=%d; gateway call/result ID pairing retained in continuation", result.Usage.TotalTokens)
+}
