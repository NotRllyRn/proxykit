+// ProxyKit audit: direct transport stream pipeline, no provider/network.
+type auditChunkPlugin struct {
+	schemas.HTTPTransportPlugin
+	name   string
+	events *[]string
+	mode   string
+}
+
+func (p *auditChunkPlugin) GetName() string { return p.name }
+func (p *auditChunkPlugin) HTTPTransportStreamChunkHook(_ *schemas.BifrostContext, _ *schemas.HTTPRequest, c *schemas.BifrostStreamChunk) (*schemas.BifrostStreamChunk, error) {
+	*p.events = append(*p.events, p.name)
+	switch p.mode {
+	case "skip":
+		return nil, nil
+	case "error-with-chunk":
+		return c, fmt.Errorf("policy unavailable")
+	case "abort":
+		return nil, fmt.Errorf("policy denied")
+	}
+	return c, nil
+}
+func TestProxyKitAuditChunkSemantics(t *testing.T) {
+	for _, mode := range []string{"pass", "skip", "error-with-chunk", "abort"} {
+		t.Run(mode, func(t *testing.T) {
+			events := []string{}
+			p := &pluginChunkInterceptor{plugins: []schemas.HTTPTransportPlugin{&auditChunkPlugin{name: "first", events: &events}, &auditChunkPlugin{name: "last", events: &events, mode: mode}}}
+			chunk := &schemas.BifrostStreamChunk{}
+			out, err := p.InterceptChunk(schemas.NewBifrostContext(context.Background(), schemas.NoDeadline), &schemas.HTTPRequest{}, chunk)
+			if mode == "pass" {
+				if err != nil || out != chunk || len(events) != 2 || events[0] != "last" {
+					t.Fatalf("bad pass: %v %v", err, events)
+				}
+			} else {
+				if len(events) != 1 {
+					t.Fatalf("later hook ran: %v", events)
+				}
+				if (mode == "skip") != (err == nil) {
+					t.Fatalf("bad error: %v", err)
+				}
+				if (mode == "error-with-chunk") != (out != nil) {
+					t.Fatalf("bad chunk %v", out)
+				}
+			}
+			t.Logf("mode=%s chunk-present=%t error=%v order=%v", mode, out != nil, err, events)
+		})
+	}
+}
