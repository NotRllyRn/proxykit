+// ProxyKit audit: synthetic pipeline probes, temporary checkout only.
+type auditPolicyPlugin struct {
+	fakeRoutingPlugin
+	events *[]string
+	fail   bool
+	deny   bool
+}
+
+func (p *auditPolicyPlugin) PreLLMHook(_ *schemas.BifrostContext, r *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+	*p.events = append(*p.events, "pre:"+p.name)
+	if p.deny {
+		return r, &schemas.LLMPluginShortCircuit{Error: &schemas.BifrostError{Error: &schemas.ErrorField{Message: "policy denied"}, AllowFallbacks: schemas.Ptr(false)}}, nil
+	}
+	if p.fail {
+		r.ChatRequest.Model = "mutation-survives-error"
+		return r, nil, fmt.Errorf("policy unavailable")
+	}
+	return r, nil, nil
+}
+func (p *auditPolicyPlugin) PostLLMHook(_ *schemas.BifrostContext, r *schemas.BifrostResponse, e *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError, error) {
+	*p.events = append(*p.events, "post:"+p.name)
+	return r, e, nil
+}
+func TestProxyKitAuditPolicyErrorAndShortCircuit(t *testing.T) {
+	for _, deny := range []bool{false, true} {
+		t.Run(fmt.Sprint("deny=", deny), func(t *testing.T) {
+			events := []string{}
+			p := &PluginPipeline{logger: NewDefaultLogger(schemas.LogLevelError), tracer: &schemas.NoOpTracer{}, llmPlugins: []schemas.LLMPlugin{&auditPolicyPlugin{fakeRoutingPlugin: fakeRoutingPlugin{name: "policy"}, events: &events, fail: !deny, deny: deny}, &auditPolicyPlugin{fakeRoutingPlugin: fakeRoutingPlugin{name: "observer"}, events: &events}}}
+			ctx := schemas.NewBifrostContext(context.Background(), schemas.NoDeadline)
+			req, sc, count := p.RunLLMPreHooks(ctx, &schemas.BifrostRequest{ChatRequest: &schemas.BifrostChatRequest{Model: "original"}})
+			p.RunPostLLMHooks(ctx, nil, nil, count)
+			if deny {
+				if sc == nil || count != 1 || strings.Join(events, ",") != "pre:policy,post:policy" {
+					t.Fatalf("sc=%v count=%d events=%v", sc, count, events)
+				}
+			} else {
+				if sc != nil || count != 2 || req.ChatRequest.Model != "mutation-survives-error" || strings.Join(events, ",") != "pre:policy,pre:observer,post:observer,post:policy" {
+					t.Fatalf("sc=%v count=%d model=%s events=%v", sc, count, req.ChatRequest.Model, events)
+				}
+			}
+			t.Logf("short-circuit=%t hook count=%d model=%s order=%v", sc != nil, count, req.ChatRequest.Model, events)
+		})
+	}
+}
